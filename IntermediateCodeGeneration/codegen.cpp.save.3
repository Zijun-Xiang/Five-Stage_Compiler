int offsetRegister(VarKind v){
	switch(v){
	  case Local: return FP;
	  case Parameter: return FP;
	  case Global: return GP;
	  case LocalStatic: return GP;
	  default:
	    printf("ERROR(codegen): looking up offset register for a variable of type %d\n", v);
	    return 666;
	}
}

void commentLineNum(TreeNode *currnode){
	char buf[16];
	if(linenumFlag){
	  sprintf(buf, "%d", currnode->lineno);
	  emitComment((char *)"Line: ", buf);
	}
}


void codegenHeader(char *srcFile){
  emitComment((char *)"bC compiler version bC-2025");
  emitComment((char *)"File compiled: ", srcFile);
}

void codegenStatement(TreeNode *currnode){
	int skiploc = 0, skiploc2 = 0, currloc = 0;
	TreeNode *loopindex = NULL;
	commentLineNum(currnode);
	switch(currnode->kind.stmt){
	   case CompoundK:{
		//printf("四");
                int savedToffset = toffset;
                toffset = currnode -> size;
                emitComment((char *)"COMPOUND");
                emitComment((char *)"TOFF set:", toffset);////////////////////////////////////////////
		//emitComment((char *)"Compound Body");
                codegenGeneral(currnode->child[0]);
                emitComment((char *)"Compound Body");
                codegenGeneral(currnode->child[1]);
                toffset = savedToffset;
                emitComment((char *)"TOFF set:", toffset);/////////////////////////////////////////////
                emitComment((char *)"END COMPOUND");
           }
                break;
	  

	   case IfK:
	      emitComment((char *)"IF");
	      codegenExpression(currnode->child[0]);    ///////////
	      skiploc = emitSkip(1);
	      emitComment((char *)"THEN");
	      codegenStatement(currnode->child[1]);
	   if(currnode->child[2]){
		skiploc2 = emitSkip(1);
		backPatchAJumpToHere(skiploc, (char *)"Jump around the THEN if false [backpatch]");
		emitComment((char *)"ELSE");
		codegenStatement(currnode->child[2]);
		backPatchAJumpToHere(skiploc2,(char *)"Jump around the ELSE [backpatch]");
	   }else{
		backPatchAJumpToHere(skiploc, (char *)"Jump around the THEN if false [backpatch]"); 
	   }
	   emitComment((char *)"END IF");
	   break;
	  
	   case WhileK:
		break;
	
	   default:
		break;
      }//switch的收尾括号
}

void codegenExpression(TreeNode *currnode){
	commentLineNum(currnode);
	switch(currnode->kind.exp){
		case AssignK:{
			TreeNode *lhs = currnode->child[0];
			//printf("五");
			//codegenExpression(currnode->child[1]);
			if(lhs->attr.op == '['){
				int tempregister=1;
                                if(currnode->child[1]){codegenExpression(currnode->child[1]);}
				if(lhs->child[0]->varKind==Global) tempregister = GP;
				if(lhs->child[0]->varKind==Local) tempregister = FP; 
				if(lhs->child[0]->varKind==LocalStatic) tempregister = GP;
				switch(currnode->attr.op){
					case INC:
					   emitRM((char *)"LDC", AC, lhs->child[1]->attr.value, AC3,
                                           (char *)"Load integer constant");
                                           emitRM((char *)"LDA", AC2, lhs->child[0]->offset,tempregister,
						 (char *)"Load address of base of array", lhs->child[0]->attr.name);
					   emitRO((char *)"SUB", AC2, AC2, AC, (char *)"Compute offset of value");
					   emitRM((char *)"LD", AC, lhs->offset, AC2,(char *)"load lhs variable", lhs->child[0]->attr.name);
					   emitRM((char *)"LDA", AC, 1, AC, (char *)"increment value of", lhs->child[0]->attr.name);
					   emitRM((char *)"ST", AC, lhs->offset, AC2, (char *)"Store variable", lhs->child[0]->attr.name);	
					break;
					case DEC:
					   emitRM((char *)"LDC", AC, lhs->child[1]->attr.value, AC3,
                                           	 (char *)"Load integer constant");
                                           emitRM((char *)"LDA", AC2, lhs->child[0]->offset, tempregister, 
						(char *)"Load address of base of array", lhs->child[0]->attr.name);
                                           emitRO((char *)"SUB", AC2, AC2, AC, (char *)"Compute offset of value");
                                           emitRM((char *)"LD", AC, lhs->offset, AC2,(char *)"load lhs variable", lhs->child[0]->attr.name);
                                           emitRM((char *)"LDA", AC, -1, AC, (char *)"decrement value of", lhs->child[0]->attr.name);
                                           emitRM((char *)"ST", AC, lhs->offset, AC2, (char *)"Store variable", lhs->child[0]->attr.name);
                                        break;

					case '=':
					   emitRM((char *)"ST", AC, lhs->offset, tempregister, (char *)"Store variable", lhs->attr.name);
					break;
					
					case ADDASS:
                                           printf("夹");
					   emitRM((char *)"LDC", AC, lhs->child[0]->offset,  tempregister,
                                           (char *)"load integer constant");
                                           //emitRO((char *)"ADD", AC, AC1, AC, (char *)"op +=");
                                           //emitRM((char *)"ST", AC, lhs->offset, offReg, (char *)"Store variable", lhs->attr.name);
                                        break;
					
					default:
						break;

				}
			}else{
				int offReg = offsetRegister(lhs->varKind);
				if(currnode->child[1]){codegenExpression(currnode->child[1]);}
				switch(currnode->attr.op){
					case '=':
					   emitRM((char *)"ST", AC, lhs->offset, offReg, (char *)"Store variable", lhs->attr.name);
					break;

					case DEC:
					   emitRM((char *)"LD", AC, lhs->offset, offReg,
                                           (char *)"load lhs variable", lhs->attr.name);
					   emitRM((char *)"LDA", AC, -1, AC, (char *)"decrement value of", lhs->attr.name);
					   emitRM((char *)"ST", AC, lhs->offset, offReg, (char *)"Store variable", lhs->attr.name);					   
					break;
						
					case INC:
					    emitRM((char *)"LD", AC, lhs->offset, offReg,
                                           (char *)"load lhs variable", lhs->attr.name);
                                           emitRM((char *)"LDA", AC, 1, AC, (char *)"increment value of", lhs->attr.name);
                                           emitRM((char *)"ST", AC, lhs->offset, offReg, (char *)"Store variable", lhs->attr.name);
                                        break;

					case 287: //ADDASS
					   emitRM((char *)"LD", AC1, lhs->offset, offReg,
                                           (char *)"load lhs variable", lhs->attr.name);
                                	   emitRO((char *)"ADD", AC, AC1, AC, (char *)"op +=");
                                	   emitRM((char *)"ST", AC, lhs->offset, offReg, (char *)"Store variable", lhs->attr.name);
					break;
					
					case MULASS:
					   
					   emitRM((char *)"LD", AC1, lhs->offset, offReg,
                                           (char *)"load lhs variable", lhs->attr.name);
                                           emitRO((char *)"MUL", AC, AC1, AC, (char *)"op *=");
                                           emitRM((char *)"ST", AC, lhs->offset, offReg, (char *)"Store variable", lhs->attr.name);
					break; 

					case DIVASS:
					   //printf("除");
					   emitRM((char *)"LD", AC1, lhs->offset, offReg,
                                           (char *)"load lhs variable", lhs->attr.name);
					   emitRO((char *)"DIV", AC, AC1, AC, (char *)"op /=");
					   emitRM((char *)"ST", AC, lhs->offset, offReg, (char *)"Store variable", lhs->attr.name);
					   
					break;
					case SUBASS:
					   emitRM((char *)"LD", AC1, lhs->offset, offReg,
                                           (char *)"load lhs variable", lhs->attr.name);
                                           emitRO((char *)"SUB", AC, AC1, AC, (char *)"op -=");
                                           emitRM((char *)"ST", AC, lhs->offset, offReg, (char *)"Store variable", lhs->attr.name);
					break;
					}
				
				
			}
		}
		break;
		
		case OpK:
			//codegenExpression(currnode->child[0]);
			commentLineNum(currnode);////
			if(currnode->child[1]){
			  codegenExpression(currnode->child[0]);
			  emitRM((char *)"ST", AC, toffset, FP, (char *)"Push left side");
			  toffset--;
			  emitComment((char *)"TOFF dec:", toffset);
			  codegenExpression(currnode->child[1]);
			  toffset++;
			  emitComment((char *)"TOFF inc:", toffset);
			  emitRM((char *)"LD", AC1, toffset, FP, (char *)"Pop left into ac1");
			  
			  switch(currnode->attr.op){
			    case '+':
				emitRO((char *)"ADD", AC, AC1, AC, (char *)"Op +");
				break;
			 
 			   //case ADDASS:         ADDASS是属于AssignK这个case里面的
			   //	emitRO((char *)"ADD", AC, AC1, AC, (char *)"Op +");
			  }
			}else{
			  codegenExpression(currnode->child[0]);
			  switch(currnode->attr.op){
			    case '-':
				emitRO((char *)"NEG", AC, AC, AC, (char *)"Op unary -");
				break;
			  }
			}
			break;
		case ConstantK:
			switch(currnode->type){
			  case Integer:			
				printf("整数");
			    emitRM((char *)"LDC", AC, , 6, (char *)"Load integer constant");
			    break;
			  case Boolean:
			if(strcmp(currnode->attr.name, "true") == 0) emitRM((char *)"LDC", AC, 1 , 6, (char *)"Load Boolean constant");
			if(strcmp(currnode->attr.name,"false") == 0) emitRM((char *)"LDC", AC, 0 , 6, (char *)"Load Boolean constant");
			    break;
			  case Char:
			    if(currnode->isArray){
				emitStrLit(currnode->offset, currnode->attr.string);
				emitRM((char *)"LDA", AC, currnode->offset, 0, (char *)"Load address of char array");
			    }else{
				emitRM((char *)"LDC", AC, currnode->attr.cvalue, 6, (char *)"Load char constant");
			    }
			    break;
			  default:
			    break;
				
			}
			break;
		
		case IdK:
	//		emitRM((char *)"LDA", AC, currnode->offset, offsetRegister(currnode->varKind),
          //                       (char *)"Load address of base of array", currnode->attr.name);
			if(currnode->isArray && !currnode->child[0]){
			printf("时");
			  emitRM((char *)"LDA", AC, currnode->offset, offsetRegister(currnode->varKind),
				 (char *)"Load address of base of array", currnode->attr.name);
			}else if(currnode->child[0]){
				
			}else{
			  emitRM((char *)"LD", AC, currnode->offset, offsetRegister(currnode->varKind),
                                 (char *)"Load variable", currnode->attr.name);
			}
			break;
		case CallK:
			
			break;
		default:
			break;
	}
}

void codegenDecl(TreeNode *currnode){
	commentLineNum(currnode);
	switch(currnode->kind.decl){
	   case VarK:
		//printf("一");
		if(currnode->attr.op=='[') ;
