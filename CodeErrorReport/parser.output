Grammar

    0 $accept: program $end

    1 program: precomList declList

    2 precomList: precomList PRECOMPILER
    3           | PRECOMPILER
    4           | %empty

    5 declList: declList decl
    6         | decl

    7 decl: varDecl
    8     | funDecl
    9     | error

   10 varDecl: typeSpec varDeclList ';'
   11        | error varDeclList ';'
   12        | typeSpec error ';'

   13 scopedVarDecl: STATIC typeSpec varDeclList ';'
   14              | typeSpec varDeclList ';'
   15              | STATIC typeSpec ';'
   16              | typeSpec error ';'

   17 varDeclList: varDeclList ',' varDeclInit
   18            | varDeclList ',' error
   19            | varDeclInit
   20            | error

   21 varDeclInit: varDeclId
   22            | varDeclId ':' simpleExp
   23            | error ':' simpleExp
   24            | varDeclId ':' error

   25 varDeclId: ID
   26          | ID '[' NUMCONST ']'
   27          | ID '[' error
   28          | error ']'

   29 typeSpec: INT
   30         | BOOL
   31         | CHAR

   32 funDecl: typeSpec ID '(' parms ')' stmt
   33        | ID '(' parms ')' stmt
   34        | typeSpec error
   35        | typeSpec ID '(' error
   36        | typeSpec ID '(' parms ')' error
   37        | ID '(' error
   38        | ID '(' parms ')' error

   39 parms: parmList
   40      | %empty

   41 parmList: parmList ';' parmTypeList
   42         | parmTypeList
   43         | parmList ';' error
   44         | error

   45 parmTypeList: typeSpec parmIdList
   46             | typeSpec error

   47 parmIdList: parmIdList ',' parmId
   48           | parmId
   49           | error

   50 parmId: ID
   51       | ID '[' ']'
   52       | error ']'

   53 stmt: matched
   54     | unmatched

   55 matched: IF simpleExp THEN matched ELSE matched
   56        | IF error THEN matched ELSE unmatched
   57        | IF error THEN matched ELSE matched
   58        | IF error
   59        | IF error ELSE matched
   60        | WHILE simpleExp DO matched
   61        | FOR ID '=' iterRange DO matched
   62        | expStmt
   63        | compoundStmt
   64        | returnStmt
   65        | breakStmt

   66 iterRange: simpleExp TO simpleExp
   67          | simpleExp TO simpleExp BY simpleExp
   68          | simpleExp TO simpleExp BY error
   69          | simpleExp TO error
   70          | error BY error

   71 unmatched: IF simpleExp THEN stmt
   72          | IF error THEN stmt
   73          | IF simpleExp THEN matched ELSE unmatched
   74          | WHILE simpleExp DO unmatched
   75          | FOR ID '=' iterRange DO unmatched

   76 expStmt: exp ';'
   77        | error ';'
   78        | ';'

   79 compoundStmt: '{' localDecls stmtList '}'

   80 localDecls: localDecls scopedVarDecl
   81           | %empty

   82 stmtList: stmtList stmt
   83         | %empty

   84 returnStmt: RETURN ';'
   85           | RETURN exp ';'

   86 breakStmt: BREAK ';'

   87 exp: mutable assignop exp
   88    | mutable INC
   89    | mutable DEC
   90    | simpleExp
   91    | error assignop exp
   92    | mutable assignop error
   93    | error INC
   94    | error DEC

   95 assignop: '='
   96         | ADDASS
   97         | SUBASS
   98         | MULASS
   99         | DIVASS

  100 simpleExp: simpleExp OR andExp
  101          | andExp
  102          | simpleExp OR error

  103 andExp: andExp AND unaryRelExp
  104       | unaryRelExp
  105       | andExp AND error

  106 unaryRelExp: NOT unaryRelExp
  107            | relExp
  108            | NOT error

  109 relExp: minmaxExp relop minmaxExp
  110       | minmaxExp

  111 relop: LEQ
  112      | '<'
  113      | '>'
  114      | GEQ
  115      | EQ
  116      | NEQ

  117 minmaxExp: minmaxExp minmaxop sumExp
  118          | sumExp

  119 minmaxop: MAX
  120         | MIN

  121 sumExp: sumExp sumop mulExp
  122       | mulExp
  123       | sumExp sumop error

  124 sumop: '+'
  125      | '-'

  126 mulExp: mulExp mulop unaryExp
  127       | unaryExp
  128       | mulExp mulop error

  129 mulop: '*'
  130      | '/'
  131      | '%'

  132 unaryExp: unaryop unaryExp
  133         | factor
  134         | unaryop error

  135 unaryop: '-'
  136        | '*'
  137        | '?'

  138 factor: immutable
  139       | mutable

  140 mutable: ID
  141        | ID '[' exp ']'

  142 immutable: '(' exp ')'
  143          | call
  144          | constant
  145          | '(' error
  146          | error '('

  147 call: ID '(' args ')'

  148 args: argList
  149     | %empty

  150 argList: argList ',' exp
  151        | exp

  152 constant: NUMCONST
  153         | CHARCONST
  154         | STRINGCONST
  155         | BOOLCONST


