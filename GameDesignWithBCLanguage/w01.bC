bool CheckWinCondition(){
	for i=0 to 4 do{
		if board1[i]==2048 or board2[i]==2048 or board3[i]==2048 or board4[i]==2048 then{
		//	printstr("CONGRATULATION!YOU WIN 2048 GAME");
			return false;
		} 
	}
	return true;
}
int main(){	
	initboard();
	printboard();
	while CheckWinCondition() do{
		direction = inputc();
		if direction == 'q'then {
			break;
		}
		if direction == 'o' then{
			dnumber();
		}
		if direction == 'm' then{
                        timenumber();
                }
		Move(direction);
		printboard();
	}
	printstr("CONGRATULATION!YOU WIN 2048 GAME");
	return 0;
}

