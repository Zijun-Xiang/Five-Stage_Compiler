timenumber(){
int row,column;
row = input();
column = input();
	if row == 0 then{
		board1[column]=2*board1[column];	
	}
	if row == 1 then{
                board2[column]=2*board2[column];
        }
	if row == 2 then{
                board3[column]=2*board3[column];
        }
	if row == 3 then{
                board4[column]=2*board4[column];
        }
}

dnumber(){
int row,column;
row = input();
column = input();
        if row == 0 then{
                board1[column]=board1[column]/2;
        }
        if row == 1 then{
                board2[column]=board2[column]/2;
        }
        if row == 2 then{
                board3[column]=board3[column]/2;
        }
        if row == 3 then{
                board4[column]=board4[column]/2;
        }
}

