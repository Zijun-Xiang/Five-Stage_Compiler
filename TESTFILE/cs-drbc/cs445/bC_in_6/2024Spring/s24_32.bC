// create a "void" function that accepts many parameters
// can iterate with many outcomes, allows for nesting and matching
fortuneTeller(char firstInitial, lastInitial, bloodType; int age, height){

    int a, b, c, d, e, i;

    c = (age * height);
    c = (age - height);
    d = age % height;
    d = age / height;

    for e = 1 to b do{
        if bloodType != 'A' or bloodType == 'B' and age == height then{
           badFortune = true;
           break;
        }
    }

    if age < height then {
       goodFortune = true;
    }

    while age < height do{
      age += age;
      for e = age to height do
      if age % 2 == 0 then
        goodFortune = true;
      else
      while height % 2 == 0 do
        if height < 1000 then
	  height += height;
    }

    for i = 0 to b by 2 do
      age += age;
    
}

