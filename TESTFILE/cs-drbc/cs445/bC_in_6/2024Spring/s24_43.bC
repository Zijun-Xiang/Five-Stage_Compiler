// Variable declarations follow <varDecl> rule
int x: 42, y: 666;
char testChar[20]: "Shashwot Niraula";
int number[5];
bool flag: true;
bool isGreater;
// typeSpec varDeclList ';'
// char charVar, stringVar[20]: "Hello";

bool notFlag: !flag;

// Character constant follows <constant> rule
char charConst: 'A';

// Random number generation follows <expstmt> rule
int randomValue: ?10;

// Error handling example with an invalid array index
int invalidIndex: 1000;

// Error handling with an invalid unary expression
int invalidUnaryExp: !flag; // This will generate an error

// MAX function follows <call> and <argList> rules
int maxResult: MAX(x, y);
// MIN function follows <call> and <argList> rules
int minResult: MIN(x, y);

// accordance with the rules 40 and 41.
int result: -x;  // Unary minus
int dereferenceResult: *ptr;  // Unary dereference
int randomResult: ?5;  // Unary random operator

int myFun1(char x, y; int z) {
    // Function body
   myFun1('z','y','z');
}


