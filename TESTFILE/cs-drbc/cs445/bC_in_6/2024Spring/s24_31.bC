}

int addFunction(int importantTime, timeToTake; bool useMax)
{
   static int numToAdd: 0;

   if useMax then
   {
      numToAdd += 2;
      return importantTime + (timeToTake :>: numToAdd);
   }
   else
   {
      numToAdd += 1;
      return importantTime + (timeToTake :<: numToAdd);
   }
}

int mulFunction(int multiplicand, multiplier)
{
   int product: multiplicand;
   product *= multiplier;
   return product;
}

