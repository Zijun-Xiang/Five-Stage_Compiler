bool someNumStuff() {
   // testing rules 37, 38
   int modulusResult, divResult, subResult, addResult, mulResult;
   modulusResult = 19 % 10;
   divResult = 19 / 10;
   subResult = 19 - 10;
   mulResult = 1;

   // testing rule 28
   mulResult *= subResult;
   addResult += modulusResult;
   divResult /= 1;
   subResult -= 3;

   // testing rule 27
   if divResult >= subResult or modulusResult <= addResult or modulusResult != addResult then subResult--;
         
   return true;
}

