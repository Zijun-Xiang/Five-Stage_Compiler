//example of a sub function
bool alwaysTrue(int counter)
{
    return true;
}

bool alwaysFalse(int x, y, z)
{
    int new : x + y;
    z = z - new;
    if((z < new) and (z < x)) then {z++;}
    else if(x > y) then {z = z*3;}
    else {z = z/2;}
    return false;
}

doNothing()
{
    int x : 5, y : 17;
    if((x <= y) and not((x-2)%3 == 1)) then
    {
        if(x+y >= (y-2)*2) then
        {
            y = 5;
        }
        else
        {
            y = y%3;
        }
    }
    else
    {
        if(y == x) then {return;}
    }
    return;
}

